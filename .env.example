# Battery endpoint reachable from the Docker bridge network.
CFE_BATTERY_HOST=battery.example.com
CFE_BATTERY_PORT=6868

CFE_CONNECT_TIMEOUT=5
CFE_READ_TIMEOUT=10
CFE_RECONNECT_DELAY=5
CFE_STALE_AFTER=30

# Set host and credentials for the existing Home Assistant MQTT broker.
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=cfebms

LOG_LEVEL=INFO
HEARTBEAT_LOG_INTERVAL_MIN=60
